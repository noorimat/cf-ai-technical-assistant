{
        "$schema": "node_modules/wrangler/config-schema.json",
        "name": "cf-ai-technical-assistant",
        "main": "src/index.ts",
        "compatibility_date": "2025-09-27",
        "migrations": [
                {
                        "new_sqlite_classes": [
                                "ChatHistory"
                        ],
                        "tag": "v1"
                }
        ],
        "durable_objects": {
                "bindings": [
                        {
                                "class_name": "ChatHistory",
                                "name": "CHAT_HISTORY"
                        }
                ]
        },
        "ai": {
                "binding": "AI"
        },
        "observability": {
                "enabled": true
        }
}
